# XMX Page Reviewer — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores

# Chave da API Anthropic (obrigatório)
ANTHROPIC_API_KEY=sk-ant-coloque-sua-chave-aqui

# Token da API do Figma (necessário para revisão visual do Figma)
FIGMA_TOKEN=figd_coloque-seu-token-aqui

# Porta do servidor (opcional, padrão: 3000)
PORT=3000
